# Uploaded images only. Never run scripts from this folder.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps
<FilesMatch "\.(?i:php\d?|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
